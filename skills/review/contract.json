{
  "contractVersion": "harness.contract/1",
  "schemaVersion": "harness.schema/1",
  "stage": "review",
  "reads": [
    "acceptance",
    "changedPaths",
    "diff",
    "handoff",
    "evidence",
    "assumptions"
  ],
  "writes": [
    "findings",
    "verdict",
    "reviewedHead"
  ],
  "input": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "unit",
      "targetUnit",
      "stage",
      "attempt",
      "inputRevision",
      "inputDigest",
      "head",
      "contentFingerprint",
      "data"
    ],
    "properties": {
      "unit": {
        "type": "string"
      },
      "targetUnit": {
        "type": "string"
      },
      "stage": {
        "type": "string"
      },
      "attempt": {
        "type": "integer",
        "minimum": 1
      },
      "inputRevision": {
        "type": "integer",
        "minimum": 1
      },
      "inputDigest": {
        "type": "string"
      },
      "head": {
        "type": "string"
      },
      "contentFingerprint": {
        "type": "string"
      },
      "data": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "acceptance",
          "changedPaths",
          "diff",
          "handoff",
          "evidence",
          "assumptions"
        ],
        "properties": {
          "acceptance": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          },
          "changedPaths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diff": {
            "type": "object",
            "properties": {}
          },
          "handoff": {
            "type": "object",
            "properties": {}
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          },
          "assumptions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {}
            }
          }
        }
      },
      "priorFindings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "digest",
            "finding"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string"
            },
            "finding": {
              "type": "object",
              "properties": {}
            }
          }
        }
      }
    }
  },
  "output": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "inputDigest",
      "attempt",
      "submissionId",
      "status",
      "summary",
      "findings",
      "verdict",
      "reviewedHead"
    ],
    "properties": {
      "inputDigest": {
        "type": "string"
      },
      "attempt": {
        "type": "integer",
        "minimum": 1
      },
      "submissionId": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "done",
          "blocked",
          "needs-decision",
          "needs-diagnosis"
        ]
      },
      "summary": {
        "type": "string"
      },
      "verdict": {
        "type": "string",
        "enum": [
          "ship",
          "fix"
        ]
      },
      "reviewedHead": {
        "type": "string"
      },
      "findings": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "kind",
            "severity",
            "site",
            "claim",
            "case",
            "fix"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "review",
                "coverage"
              ]
            },
            "severity": {
              "type": "string",
              "enum": [
                "must-fix",
                "should-fix",
                "nice"
              ]
            },
            "site": {
              "type": "string"
            },
            "claim": {
              "type": "string"
            },
            "case": {
              "type": "string"
            },
            "fix": {
              "type": "string"
            },
            "acceptanceRef": {
              "type": "string"
            },
            "classification": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "product",
                "harness",
                "environment",
                "user-domain",
                null
              ]
            },
            "resolvedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      },
      "findingVerifications": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "index",
            "digest",
            "verified",
            "case",
            "evidence"
          ],
          "properties": {
            "index": {
              "type": "integer",
              "minimum": 0
            },
            "digest": {
              "type": "string"
            },
            "verified": {
              "type": "boolean"
            },
            "case": {
              "type": "string"
            },
            "evidence": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
